# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Security - added by audit
.env
.env.local
.env.*.local
scripts/.schema-sync.env

# Schema is managed from the iOS repo (GMI/sql/) via the Management API.
# The Supabase CLI recreates this dir on db pull — never commit or db push it.
supabase/migrations/
supabase/.temp/

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
.env.local

# Sync-conflict copies (iCloud/Dropbox-style "filename 2.ext", "filename 3.ext").
# These are junk duplicates created when files are written rapidly inside a synced
# folder — never real source. Ignore so they can't be accidentally committed.
* [0-9].*
