VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Product analytics + error reporting are no-ops unless these are set (owner action, roadmap decision D8)
#
# POPIA: turning these on starts collecting personal information (user id, role, page
# URLs, IP). Before setting a key the owner must decide the lawful basis and publish a
# privacy notice covering it — this is an owner decision, not a deploy step. Also, in
# the PostHog project itself: keep session replay OFF (it records the screen, including
# tenant data), and turn on "Discard client IP data" — the SDK's `ip` init option is a
# documented no-op in posthog-js 1.429.x, so the project setting is the only lever.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_SENTRY_DSN=

# Live smokes (scripts/*-smoke.mjs, scripts/offline-smoke.ts) do NOT read this file. They take
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY from the shell and refuse the
# production ref unless SMOKE_ALLOW_PROD=1.
#
# `npm run smoke:offline` is the one smoke that runs the app's own Supabase client (through
# vite-node), and that client reads VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY, which Vite
# inlines when vite-node starts. The npm script therefore maps SUPABASE_URL -> VITE_SUPABASE_URL
# and SUPABASE_ANON_KEY -> VITE_SUPABASE_PUBLISHABLE_KEY in the shell before launching; without
# that mapping the client would silently pick up the VITE_* values from .env / .env.local (this
# file's siblings) while the fixtures went to SUPABASE_URL. The script aborts if the two differ.

# Web Push (R2c). The Profile "Push notifications on this device" switch is hidden until this is
# set to the VAPID public key whose private half lives in the Supabase function secrets.
VITE_VAPID_PUBLIC_KEY=
